        "/src/http/**",
        "/src/ixml/**",
        "/src/json/**",
        "/src/kernel/**",
        "/src/memory/**",
        "/src/numberrange/**",
        "/src/oauth2/**",
        "/src/oo/**",
        "/src/package/**",
        "/src/persistence/**",
        "/src/rtti/**",
        "/src/shma/**",
        "/src/smim/**",
        "/src/sxml/**",
        "/src/unit/**",
        "/src/uuid/**",
        "/src/w3mi/**",
